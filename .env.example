# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite file is committed with seeded demo data):
DATABASE_URL="file:../db/custom.db"

# Production / Vercel (Turso — free serverless SQLite, works with this codebase
# out of the box). Create a database at https://turso.tech and paste the URL:
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# ── App ─────────────────────────────────────────────────────────────────────
# Demo mode: enables the one-click demo role cards on the login screen,
# in-UI OTP display for the demo, and the demo data reset endpoint.
DEMO_MODE=true

# Public URL of the deployment (used for links / branding).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
